[global]
   workgroup = WORKGROUP
   server string = Samba ASR vbox2
   netbios name = vbox2
   security = user
   map to guest = bad user
   dns proxy = no
   log file = /var/log/samba/log.%m
   max log size = 1000

[{{ samba_share_name }}]
   path = {{ samba_share_path }}
   browsable = yes
   writable = yes
   guest ok = yes
   read only = no
   create mask = 0666
   directory mask = 0777
   force user = nobody
